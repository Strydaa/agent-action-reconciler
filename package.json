{
  "name": "agent-action-reconciler",
  "version": "0.1.0",
  "description": "Reconciles agent side effects whose outcome is unknown: claim first, execute, verify, never blindly retry.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Strydaa/agent-action-reconciler.git"
  },
  "keywords": ["ai-agents", "idempotency", "side-effects", "reconciliation", "exactly-once", "sqlite"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
